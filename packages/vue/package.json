{
  "name": "autumnnote-plus-vue",
  "version": "4.0.0",
  "description": "Vue 3 wrapper for autumnnote-plus, an unofficial fork of the Autumn Note WYSIWYG editor. Mount the editor with a single component and access the full Context API via ref.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "keywords": [
    "wysiwyg",
    "wysiwyg-editor",
    "rich-text",
    "rich-text-editor",
    "vue",
    "vue3",
    "vue-wysiwyg",
    "vue-editor",
    "vue-rich-text",
    "vue-component",
    "contenteditable",
    "no-jquery",
    "vanilla-js",
    "dark-mode",
    "markdown",
    "mention",
    "bubble-toolbar",
    "toolbar",
    "autumnnote-plus",
    "summernote-alternative",
    "quill-alternative",
    "tinymce-alternative"
  ],
  "homepage": "https://github.com/habibiahmada/autumnnote-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habibiahmada/autumnnote-plus.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/habibiahmada/autumnnote-plus/issues"
  },
  "author": "Minh Pham",
  "contributors": [
    "Habibi Ahmad Aziz (https://github.com/habibiahmada)"
  ],
  "license": "MIT",
  "peerDependencies": {
    "autumnnote-plus": "^4.0.0",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autumnnote-plus": "workspace:*",
    "vite": "^8.2.1",
    "vue": "^3.5.42"
  }
}
