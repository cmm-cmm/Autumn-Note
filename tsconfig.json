{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Every strict check except the two that would need ~1000 JSDoc casts
    // across the JS sources (null checks, implicit any); tighten those per module.
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": false,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/js/**/*.js", "types/**/*.d.ts"]
}
